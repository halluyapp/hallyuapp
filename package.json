{
  "name": "hallyu",
  "version": "2.0.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "dev": "expo start --web --offline --port 3000",
    "build": "expo export -p web",
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "ios": "expo run:ios",
    "check": "npm run typecheck && npm run lint && npm run test:fandoms && npm run test:audit && npm run test:prerelease && npm run test:recognition && npm run test:upgrade && npm run test:sql && npm run test:db-types && npm run test:signatures && npm run test:apply && npm run test:backend-surface && npm run test:secrets && npm run test:tracker && npm run test:home-render && npm run test:book-diary && npm run test:timezone && npm run test:realtime && npm run test:vibe && npm run test:watch",
    "test:recognition": "node --test scripts/test-recognition-and-admin.mjs",
    "test:prerelease": "node --test scripts/test-prerelease-regressions.mjs",
    "test:prerelease:live": "node scripts/verify-prerelease-live.mjs",
    "test:upgrade": "node scripts/verify-product-upgrade.mjs",
    "test:audit": "node --test scripts/test-production-audit.mjs",
    "test:home-render": "node scripts/verify-home-render.mjs",
    "test:fandoms": "node scripts/verify-fandoms.mjs",
    "test:sql": "node scripts/verify-sql.mjs",
    "test:db-types": "node scripts/verify-db-types.mjs",
    "test:signatures": "node scripts/test-db-signatures.mjs",
    "test:apply": "node scripts/test-apply-migrations.mjs",
    "test:backend-surface": "node scripts/verify-backend-surface.mjs",
    "test:secrets": "node scripts/verify-no-secrets.mjs",
    "test:db-exec": "node scripts/localdb/apply.mjs . && node scripts/localdb/check.mjs . && node scripts/localdb/surface.mjs && node scripts/localdb/check-book-diary.mjs . && node scripts/localdb/check-notify-timezone.mjs . && node scripts/localdb/check-security-grants.mjs .",
    "test:backend": "node scripts/verify-backend.mjs",
    "migrate:live": "node scripts/ci/apply-migrations.mjs .",
    "test:tracker": "node --test scripts/test-tracker-links-and-import.mjs",
    "test:timezone": "node --test scripts/test-timezone.mjs",
    "test:book-diary": "node --test scripts/test-book-diary.mjs",
    "test:realtime": "node --test scripts/test-realtime-teardown.mjs",
    "test:vibe": "node --test scripts/test-vibe-finder.mjs",
    "test:watch": "node --test scripts/test-watch.mjs scripts/test-subtitles.mjs scripts/test-watch-subtitles.mjs",
    "test:watch-live": "node scripts/ci/watch-live-check.mjs"
  },
  "dependencies": {
    "@expo/cli": "^0.18.31",
    "@expo/metro-runtime": "~3.2.1",
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/netinfo": "^11.3.1",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~51.0.28",
    "expo-application": "~5.9.1",
    "expo-av": "~14.0.7",
    "expo-clipboard": "~6.0.2",
    "expo-constants": "~16.0.2",
    "expo-crypto": "~13.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-haptics": "~13.0.1",
    "expo-image": "~1.13.0",
    "expo-image-manipulator": "~12.0.5",
    "expo-image-picker": "~15.1.0",
    "expo-intent-launcher": "~11.0.1",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-media-library": "~16.0.5",
    "expo-notifications": "~0.28.19",
    "expo-router": "~3.5.23",
    "expo-screen-orientation": "~7.0.5",
    "expo-splash-screen": "^0.27.7",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "expo-video-thumbnails": "~8.0.0",
    "expo-web-browser": "~13.0.3",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "^0.19.13",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~7.1.2",
    "pgsql-parser": "^18.2.8",
    "typescript": "~5.3.3"
  }
}
